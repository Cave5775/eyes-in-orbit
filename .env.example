# Copy to .env (git-ignored). All variables are optional. The app itself is static: its upstream calls and storage run in the
# browser. These only configure the host (`npm run serve`) and the build.

# Port of `npm run serve` (the built app plus the /relay handler)
PORT=8080
# Bind address of `npm run serve`; loopback only by default
HOST=127.0.0.1
# Folder of the built app that `npm run serve` serves (default: apps/web/dist)
# WEB_DIST=
# Comma-separated page origins allowed to call /relay from another origin (same-origin pages need nothing)
# RELAY_ALLOWED_ORIGINS=

# Vite dev server bind address (default 127.0.0.1; 0.0.0.0 exposes the dev server and its /relay to the LAN)
# EIO_WEB_HOST=127.0.0.1

# Build-time switches, read by the data worker
# 1 = fetch CelesTrak through /relay (when the browser is blocked or rate limited directly)
# VITE_CELESTRAK_VIA_RELAY=0
# 1 = never touch the network; connectors serve whatever the browser store holds
# VITE_OFFLINE=0
