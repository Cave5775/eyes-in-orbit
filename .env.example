# Copy to .env (git-ignored). All variables are optional.

# HTTP/WS port of the server (Vite proxies /api and /stream here)
PORT=8787
# Bind address; "localhost" listens on loopback only
HOST=localhost

# Launch Library 2 free token (https://thespacedevs.com/) raises the ~15 req/h anonymous limit
LL2_TOKEN=
# LL2_BASE=https://ll.thespacedevs.com/2.2.0

# SQLite cache + trajectory files live here (default: <repo>/data)
# DATA_DIR=

# 1 = never touch the network; connectors serve whatever the SQLite cache holds
OFFLINE=0

# Connector ids that are not started at all (the others keep their network access), e.g. while a source rate-limits you:
# celestrak, launchlibrary, snapi, dsn, horizons, iss-rest, iss-live, flightclub
# DISABLED_CONNECTORS=celestrak,launchlibrary,snapi,dsn,horizons

# Comma-separated DSN Now XML candidates, tried in order
# DSN_URL=https://eyes.nasa.gov/dsn/data/dsn.xml,https://eyes.nasa.gov/dsn/dsn.xml

# Space-Track (free account at space-track.org): second source for the Starlink elements, independent of CelesTrak's limits.
# These can also be entered in the app (KEYS button in the top bar); values entered there override this file.
# SPACETRACK_USER=
# SPACETRACK_PASSWORD=

# Stub connectors (not implemented yet; setting these only changes the reported note)
# SATNOGS_TOKEN=
# WEBCAST_URL=
