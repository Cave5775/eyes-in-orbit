{
  "name": "eyes-in-orbit",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @eio/web",
    "build": "npm run build -w @eio/web",
    "serve": "npm run build && tsx apps/relay/src/node.ts",
    "test": "vitest run",
    "typecheck": "tsc -p packages/core --noEmit && tsc -p apps/web --noEmit && tsc -p apps/relay --noEmit",
    "assets": "node scripts/fetch-assets.mjs"
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
