{
  "name": "eyes-in-orbit",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n server,web -c cyan,magenta \"npm run dev -w @eio/server\" \"npm run dev -w @eio/web\"",
    "build": "npm run build -w @eio/web",
    "test": "vitest run",
    "typecheck": "tsc -p packages/core --noEmit && tsc -p apps/server --noEmit && tsc -p apps/web --noEmit",
    "assets": "node scripts/fetch-assets.mjs",
    "celestrak:probe": "tsx apps/server/src/celestrak-probe.ts",
    "celestrak:seed": "tsx apps/server/src/celestrak-seed.ts"
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
